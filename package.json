{
  "name": "graphite-vault-chat",
  "version": "0.1.0",
  "description": "Chat with your Obsidian vault. Every claim in an answer carries a quote checked against the note it cites.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "eval:vault": "node eval/run.mjs eval/generate-test-vault.ts",
    "eval:retrieval": "node eval/run.mjs eval/run-retrieval.ts",
    "eval:benchmark": "node eval/run.mjs eval/benchmark.ts"
  },
  "author": "Charan Sandaka",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
